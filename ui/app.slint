struct ErrRow {
    word: string,
    sug: string,
    page: int,
    dimmed: bool,
    kind: string,
    sev: string,
    bar: color,
    desc: string,
    count: int,
    is_group: bool,
}

struct NoteRow {
    text: string,
    page: int,
}

struct HisRow {
    name: string,
    info: string,
}

component MiniBtn inherits Rectangle {
    in property <string> label;
    in property <color> bg: #eee;
    in property <color> fg: #222;
    callback clicked;
    height: 22px;
    horizontal-stretch: 1;
    background: bg;
    border-radius: 4px;
    Text {
        text: label; color: fg; font-size: 11px;
        horizontal-alignment: center; vertical-alignment: center;
    }
    TouchArea { width: parent.width; height: parent.height; clicked => { root.clicked(); } }
}

// Desplegable propio (inline: al abrir empuja el contenido; evita std-widgets
// que sale en blanco y el gotcha del TouchArea que se traga clics).
component DropSel inherits Rectangle {
    in property <string> label;
    in property <[string]> opts;
    in-out property <int> current: 0;
    in property <color> bg: #eee;
    in property <color> fg: #222;
    in property <color> hl: #222;
    in property <color> hl-fg: white;
    callback picked(int);
    in-out property <bool> open: false;
    background: transparent;
    VerticalLayout {
        spacing: 2px;
        Rectangle {
            height: 26px;
            background: bg; border-radius: 4px;
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px; spacing: 6px;
                Text {
                    text: label + ": " + opts[current];
                    color: fg; font-size: 12px;
                    horizontal-stretch: 1; vertical-alignment: center;
                    overflow: elide;
                }
                Text { text: open ? "▲" : "▼"; color: fg; font-size: 11px; vertical-alignment: center; }
            }
            TouchArea { width: parent.width; height: parent.height; clicked => { open = !open; } }
        }
        if (open): VerticalLayout {
            spacing: 2px;
            for o[idx] in opts: Rectangle {
                height: 24px;
                background: idx == current ? hl : bg; border-radius: 4px;
                Text {
                    text: o; color: idx == current ? hl-fg : fg; font-size: 12px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea { width: parent.width; height: parent.height; clicked => { current = idx; picked(idx); open = false; } }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "LexPDF";
    min-width: 900px;
    min-height: 600px;

    in-out property <image> page-image;
    in-out property <string> page-label: "Sin documento";
    in-out property <string> status: "Sube un PDF para comenzar.";
    in-out property <int> lang-idx: 0;
    in-out property <bool> has-doc: false;
    in-out property <int> word-count: 0;
    in-out property <string> word-sample: "";
    in-out property <[ErrRow]> errors;
    in-out property <[NoteRow]> notes;
    in-out property <[HisRow]> history;
    in-out property <string> spell-status: "";
    in-out property <bool> is-dark: false;
    in-out property <bool> scanning: false;
    in-out property <int> scan-progress: 0;
    in-out property <string> scan-text: "";
    in-out property <string> lt-status: "Motor: iniciando…";
    in-out property <string> version: "?";
    in-out property <int> selected-note: -1;
    in-out property <string> note-text: "";
    in-out property <int> type-filter: 0;
    in-out property <int> sev-filter: 0;
    in-out property <string> popup-text: "";
    in-out property <int> img-w: 0;
    in-out property <int> img-h: 0;
    in-out property <string> zoom-label: "50%";
    in-out property <length> view-x: 0px;
    in-out property <length> view-y: 0px;
    in-out property <length> view-w: 0px;
    in-out property <length> view-h: 0px;
    in-out property <bool> free-note-on: false;
    in-out property <string> free-note-text: "";

    callback open-pdf();
    callback prev-page();
    callback next-page();
    callback error-clicked(int);
    callback omit-clicked(int);
    callback note-clicked(int);
    callback save-note(int);
    callback grammar-clicked(int);
    callback group-toggle(int);
    callback type-set(int);
    callback sev-set(int);
    callback popup-dismiss();
    callback docnote-clicked(int);
    callback history-open(int);
    callback zoom-in();
    callback zoom-out();
    callback zoom-text(string);
    callback page-clicked(float, float);
    callback free-note-new();
    callback free-note-save();
    callback free-note-cancel();
    callback lang-set(int);
    callback theme-toggle();

    // paleta según tema (fija, no depende del tema del SO)
    property <color> c-bg: root.is-dark ? #1e1e1e : white;
    property <color> c-fg: root.is-dark ? #e8e8e8 : #222;
    property <color> c-dim: root.is-dark ? #aaa : #666;
    property <color> c-line: root.is-dark ? #444 : #ddd;
    property <color> c-card: root.is-dark ? #2d2d2d : white;
    property <color> c-view: root.is-dark ? #141414 : #e9e9e9;
    property <color> c-pill: root.is-dark ? #333 : #eee;
    property <color> c-accent: root.is-dark ? #e8e8e8 : #222;
    property <color> c-accent-fg: root.is-dark ? #111 : white;

    HorizontalLayout {
        // Sidebar (400px como index.html)
        Rectangle {
            width: 400px;
            background: root.c-bg;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                alignment: start;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "LexPDF";
                        font-size: 18px; font-weight: 700; color: root.c-fg;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 64px; height: 28px;
                        background: root.c-pill; border-radius: 4px;
                        Text {
                            text: root.is-dark ? "Claro" : "Oscuro";
                            color: root.c-fg; font-size: 12px;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea { width: parent.width; height: parent.height; clicked => { root.theme-toggle(); } }
                    }
                }

                // upload-section
                Rectangle {
                    height: 34px;
                    background: root.c-accent;
                    border-radius: 4px;
                    Text {
                        text: "Subir y Analizar Documento";
                        color: root.c-accent-fg; font-size: 14px;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { width: parent.width; height: parent.height; clicked => { open-pdf(); } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    for m[i] in ["Auto", "ES", "EN"]: Rectangle {
                        height: 26px;
                        horizontal-stretch: 1;
                        background: root.lang-idx == i ? root.c-accent : root.c-pill;
                        border-radius: 4px;
                        Text {
                            text: m;
                            color: root.lang-idx == i ? root.c-accent-fg : root.c-fg;
                            font-size: 12px;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea { width: parent.width; height: parent.height; clicked => { root.lang-set(i); } }
                    }
                }
                Text { text <=> root.status; font-size: 13px; color: root.c-dim; wrap: word-wrap; }

                if (root.history.length > 0): VerticalLayout {
                    spacing: 4px;
                    Text { text: "Recientes"; font-size: 14px; font-weight: 700; color: root.c-fg; }
                    VerticalLayout {
                        spacing: 2px;
                        for h[i] in root.history: Rectangle {
                            height: 30px;
                            background: root.c-pill; border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 6px;
                                Text {
                                    text: h.name; color: root.c-fg; font-size: 12px; font-weight: 700;
                                    horizontal-stretch: 1; vertical-alignment: center; overflow: elide;
                                }
                                Text { text: h.info; color: root.c-dim; font-size: 11px; vertical-alignment: center; }
                            }
                            TouchArea { width: parent.width; height: parent.height; clicked => { root.history-open(i); } }
                        }
                    }
                }

                Rectangle { height: 1px; background: root.c-line; }

                // barra de escaneo: izquierda a derecha, verde
                Rectangle {
                    height: 10px;
                    background: root.c-pill; border-radius: 5px;
                    visible: root.scanning;
                    Rectangle {
                        x: 0;
                        width: parent.width * root.scan-progress / 100;
                        background: #43a047; border-radius: 5px;
                    }
                }
                Text {
                    text <=> root.scan-text; font-size: 12px; color: root.c-dim;
                    visible: root.scanning;
                }
                Text {
                    text <=> root.lt-status; font-size: 12px; color: root.c-dim;
                }
                Text {
                    text: "LexPDF v" + root.version + " · 100% local";
                    font-size: 11px; color: root.c-dim;
                }

                // resultados
                Text { text: "Resultados"; font-size: 14px; font-weight: 700; color: root.c-fg; }
                Text {
                    text: root.word-count + " palabras · " + root.spell-status;
                    font-size: 13px; font-weight: 700; color: root.c-fg;
                    visible: root.has-doc;
                }
                HorizontalLayout {
                    spacing: 6px;
                    visible: root.has-doc;
                    DropSel {
                        label: "Tipo";
                        opts: ["Todas", "Ortografía", "Sintaxis"];
                        current <=> root.type-filter;
                        bg: root.c-pill; fg: root.c-fg;
                        hl: root.c-accent; hl-fg: root.c-accent-fg;
                        horizontal-stretch: 1;
                        picked(i) => { root.type-set(i); }
                    }
                    DropSel {
                        label: "Gravedad";
                        opts: ["Todas", "Grave", "Intermedia", "Mínima"];
                        current <=> root.sev-filter;
                        bg: root.c-pill; fg: root.c-fg;
                        hl: root.c-accent; hl-fg: root.c-accent-fg;
                        horizontal-stretch: 1;
                        picked(i) => { root.sev-set(i); }
                    }
                }
                Flickable {
                    height: 420px;
                    visible: root.has-doc;
                    VerticalLayout {
                        spacing: 6px;
                        for e[i] in root.errors: Rectangle {
                            border-color: root.c-line;
                            border-width: 1px;
                            border-radius: 6px;
                            background: root.c-card;
                            opacity: e.dimmed ? 0.45 : 1;
                            HorizontalLayout {
                                spacing: 0;
                                // franja de color por tipo, como index.html
                                Rectangle { width: 5px; background: e.bar; }
                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 3px;
                                    horizontal-stretch: 1;
                                    Rectangle {
                                        height: 20px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text { text: e.word; font-size: 14px; font-weight: 700; color: root.c-fg; vertical-alignment: center; }
                                            Text { text: e.kind + " · " + e.sev + " · pág " + (e.page + 1); font-size: 12px; color: root.c-dim; vertical-alignment: center; }
                                        }
                                        TouchArea { width: parent.width; height: parent.height; clicked => { root.error-clicked(i); } }
                                    }
                                    Text { text: e.desc; font-size: 13px; font-italic: true; color: root.c-dim; wrap: word-wrap; }
                                    Text { text: e.sug; font-size: 12px; color: root.c-fg; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        MiniBtn {
                                            label: e.dimmed ? "Restaurar" : "Omitir";
                                            bg: root.c-pill; fg: root.c-fg;
                                            clicked => { root.omit-clicked(i); }
                                        }
                                        MiniBtn {
                                            label: "Comentar";
                                            bg: root.c-pill; fg: root.c-fg;
                                            clicked => { root.note-clicked(i); }
                                        }
                                        MiniBtn {
                                            label: "Obs. gramatical";
                                            bg: root.c-pill; fg: root.c-fg;
                                            clicked => { root.grammar-clicked(i); }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        visible: e.count >= 5;
                                        MiniBtn {
                                            label: e.is-group ? "Desagrupar (×" + e.count + ")" : "Agrupar (×" + e.count + ")";
                                            bg: root.c-pill; fg: root.c-fg;
                                            clicked => { root.group-toggle(i); }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 3px;
                                        visible: root.selected-note == i;
                                        Rectangle {
                                            height: 30px;
                                            background: root.c-pill; border-radius: 4px;
                                            TextInput {
                                                x: 8px; width: parent.width - 16px; height: parent.height;
                                                text <=> root.note-text;
                                                font-size: 13px; color: root.c-fg;
                                                vertical-alignment: center;
                                                accepted => {
                                                    if (root.note-text != "") { root.save-note(root.selected-note); }
                                                }
                                            }
                                        }
                                        MiniBtn {
                                            label: "Guardar en PDF";
                                            bg: root.c-accent; fg: root.c-accent-fg;
                                            clicked => { root.save-note(i); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                Text {
                    text: "El visor PDF aparecerá a la derecha cuando abras un documento.";
                    font-size: 13px; color: root.c-dim; wrap: word-wrap;
                    horizontal-alignment: center;
                    visible: !root.has-doc;
                }
                if (root.notes.length > 0): VerticalLayout {
                    spacing: 4px;
                    Text { text: "Notas en el PDF (" + root.notes.length + ")"; font-size: 14px; font-weight: 700; color: root.c-fg; }
                    VerticalLayout {
                        spacing: 2px;
                        for n[i] in root.notes: Rectangle {
                            background: root.c-card;
                            border-color: root.c-line; border-width: 1px; border-radius: 6px;
                            VerticalLayout {
                                padding: 6px; spacing: 2px;
                                horizontal-stretch: 1;
                                Text { text: n.text; font-size: 12px; color: root.c-fg; wrap: word-wrap; max-height: 34px; overflow: elide; }
                                Text { text: "pág " + (n.page + 1); font-size: 11px; color: root.c-dim; }
                            }
                            TouchArea { width: parent.width; height: parent.height; clicked => { root.docnote-clicked(i); } }
                        }
                    }
                }
            }
        }

        // visor
        Rectangle {
            background: root.c-view;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                if (root.has-doc): HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Rectangle {
                        width: 34px; height: 28px;
                        background: root.c-pill; border-radius: 4px;
                        Text { text: "◀"; color: root.c-fg; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { width: parent.width; height: parent.height; clicked => { prev-page(); } }
                    }
                    Text { text <=> root.page-label; font-size: 13px; color: root.c-dim; vertical-alignment: center; }
                    Rectangle {
                        width: 34px; height: 28px;
                        background: root.c-pill; border-radius: 4px;
                        Text { text: "▶"; color: root.c-fg; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { width: parent.width; height: parent.height; clicked => { next-page(); } }
                    }
                    Rectangle {
                        width: 52px; height: 28px;
                        background: root.c-pill; border-radius: 4px;
                        Text { text: "✎ Nota"; color: root.c-fg; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { width: parent.width; height: parent.height; clicked => { free-note-new(); } }
                    }
                    TouchArea {
                        width: 122px; height: 28px;
                        scroll-event(e) => {
                            if (e.delta-y > 0px) { zoom-in(); } else if (e.delta-y < 0px) { zoom-out(); }
                            accept
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                width: 28px; height: 28px;
                                background: root.c-pill; border-radius: 4px;
                                Text { text: "−"; color: root.c-fg; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { width: parent.width; height: parent.height; clicked => { zoom-out(); } }
                            }
                            Rectangle {
                                width: 58px; height: 28px;
                                background: root.c-pill; border-radius: 4px;
                                TextInput {
                                    text: root.zoom-label;
                                    color: root.c-fg; font-size: 12px;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    accepted => { root.zoom-text(self.text); }
                                }
                            }
                            Rectangle {
                                width: 28px; height: 28px;
                                background: root.c-pill; border-radius: 4px;
                                Text { text: "+"; color: root.c-fg; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { width: parent.width; height: parent.height; clicked => { zoom-in(); } }
                            }
                        }
                    }
                }

                if (root.has-doc): Flickable {
                    min-height: 200px;
                    vertical-stretch: 1;
                    content-width: root.img-w * 1px;
                    content-height: root.img-h * 1px;
                    content-x <=> root.view-x;
                    content-y <=> root.view-y;
                    // changed no dispara al inicio: sin init el centrado divide con 0
                    init => { root.view-w = self.width; root.view-h = self.height; }
                    changed width => { root.view-w = self.width; }
                    changed height => { root.view-h = self.height; }
                    Rectangle {
                        width: root.img-w * 1px;
                        height: root.img-h * 1px;
                        Image {
                            source <=> root.page-image;
                            width: 100%; height: 100%;
                        }
                        // solo en modo nota: el toque marca el punto, no interfiere si no
                        if (root.free-note-on): pg-touch := TouchArea {
                            width: 100%; height: 100%;
                            clicked => { root.page-clicked(pg-touch.mouse-x / 1px, pg-touch.mouse-y / 1px); }
                        }
                    }
                }

                if (root.free-note-on): VerticalLayout {
                    spacing: 3px;
                    visible: root.has-doc;
                    Text { text: "Toca el punto del documento, escribe y guarda."; font-size: 12px; color: root.c-dim; wrap: word-wrap; }
                    Rectangle {
                        height: 30px;
                        background: root.c-card; border-radius: 4px;
                        border-width: 1px; border-color: root.c-line;
                        TextInput {
                            x: 8px; width: parent.width - 16px; height: parent.height;
                            text <=> root.free-note-text;
                            font-size: 13px; color: root.c-fg;
                            vertical-alignment: center;
                            accepted => { if (root.free-note-text != "") { root.free-note-save(); } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        MiniBtn {
                            label: "Guardar nota";
                            bg: root.c-accent; fg: root.c-accent-fg;
                            clicked => { root.free-note-save(); }
                        }
                        MiniBtn {
                            label: "Cancelar";
                            bg: root.c-pill; fg: root.c-fg;
                            clicked => { root.free-note-cancel(); }
                        }
                    }
                }

                if (!root.has-doc): Text {
                    text: "Sin documento";
                    font-size: 14px; color: root.c-dim;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    vertical-stretch: 1;
                }
            }
            // toast minimalista: pastilla centrada abajo, clic para cerrar
            if (root.popup-text != ""): Rectangle {
                width: min(520px, parent.width - 32px);
                height: 52px;
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 16px;
                background: root.c-accent; border-radius: 8px;
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px; spacing: 10px;
                    Text {
                        text: root.popup-text;
                        color: root.c-accent-fg; font-size: 13px;
                        horizontal-stretch: 1; vertical-alignment: center;
                        wrap: word-wrap; overflow: elide;
                    }
                    Text { text: "✕"; color: root.c-accent-fg; font-size: 12px; vertical-alignment: center; }
                }
                TouchArea { width: parent.width; height: parent.height; clicked => { root.popup-dismiss(); } }
            }
        }
    }
}
