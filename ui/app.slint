struct ErrRow {
    word: string,
    sug: string,
    page: int,
    dimmed: bool,
    kind: string,
    sev: string,
    bar: color,
    desc: string,
    count: int,
    is_group: bool,
    has_anno: bool,   // ya tiene resaltado+comentario (se puede borrar)
}

struct NoteRow {
    text: string,   // el comentario (texto plano)
    page: int,
    x: float,   // px en la imagen de la página (origen arriba-izq)
    y: float,
    w: float,   // ancho de la zona de hover (el rectángulo del resaltado)
    h: float,
    idx: int,   // índice en la lista (para borrar)
}

struct HisRow {
    name: string,
    info: string,
}

component MiniBtn inherits Rectangle {
    in property <string> label;
    in property <color> bg: #eee;
    in property <color> fg: #222;
    in property <color> bd: transparent;   // borde (en oscuro se ve mejor)
    callback clicked;
    height: 22px;
    horizontal-stretch: 1;
    background: bg;
    border-radius: 4px;
    border-width: 1px;
    border-color: bd;
    Text {
        text: label; color: fg; font-size: 11px;
        // Text es @implicit_size: sin width/height explicitos el texto se pega
        // a la izquierda de la pastilla y horizontal-alignment no hace nada.
        width: parent.width; height: parent.height;
        horizontal-alignment: center; vertical-alignment: center;
        overflow: elide;
    }
    TouchArea { width: parent.width; height: parent.height; clicked => { root.clicked(); } }
}

// Desplegable propio (inline: al abrir empuja el contenido; evita std-widgets
// que sale en blanco y el gotcha del TouchArea que se traga clics).
component DropSel inherits Rectangle {
    in property <string> label;
    in property <[string]> opts;
    in-out property <int> current: 0;
    in property <color> bg: #eee;
    in property <color> fg: #222;
    in property <color> bd: transparent;   // borde (en oscuro se ve mejor)
    in property <color> hl: #222;
    in property <color> hl-fg: white;
    callback picked(int);
    in-out property <bool> open: false;
    background: transparent;
    VerticalLayout {
        spacing: 2px;
        Rectangle {
            height: 26px;
            background: bg; border-radius: 4px;
            border-width: 1px; border-color: bd;
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px; spacing: 6px;
                Text {
                    text: label + ": " + opts[current];
                    color: fg; font-size: 12px;
                    horizontal-stretch: 1; vertical-alignment: center;
                    overflow: elide;
                }
                Text { text: open ? "▲" : "▼"; color: fg; font-size: 11px; vertical-alignment: center; }
            }
            TouchArea { width: parent.width; height: parent.height; clicked => { open = !open; } }
        }
        if (open): VerticalLayout {
            spacing: 2px;
            for o[idx] in opts: Rectangle {
                height: 24px;
                background: idx == current ? hl : bg; border-radius: 4px;
                Text {
                    text: o; color: idx == current ? hl-fg : fg; font-size: 12px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea { width: parent.width; height: parent.height; clicked => { current = idx; picked(idx); open = false; } }
            }
        }
    }
}

// Ventana de Ajustes (aparte). El estado vive en el root; aquí se edita y se
// aplica con el botón Guardar.
export component SettingsWindow inherits Window {
    title: "Ajustes · LexPDF";
    width: 520px;
    height: 860px;
    background: #1e1e1e;

    in-out property <int> hl-color: 0;    // 0 = por gravedad, 1 = amarillo
    in-out property <int> copy-mode: 0;   // 0 = preguntar, 1 = siempre, 2 = nunca
    in-out property <bool> motor-on: true;
    in-out property <int> free-sel: 0;    // 0 = área, 1 = texto
    in-out property <int> free-text: 1;   // con free-sel=1: 0 = recuadros, 1 = selección
    callback apply(int, int, bool, int, int);
    callback open-about();

    VerticalLayout {
        padding: 18px;
        spacing: 14px;

        Text { text: "Ajustes"; font-size: 18px; font-weight: 700; color: #e8e8e8; }

        // --- color del resaltado
        VerticalLayout {
            spacing: 6px;
            Text { text: "Color del resaltado"; font-size: 14px; font-weight: 700; color: #e8e8e8; }
            Text {
                text: "• Por gravedad: rojo = ortografía, morado = sintaxis.";
                font-size: 12px; color: #aaa; wrap: word-wrap;
            }
            Text {
                text: "• Amarillo único: todos los resaltados en amarillo.";
                font-size: 12px; color: #aaa; wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    height: 30px; horizontal-stretch: 1; border-radius: 4px;
                    background: root.hl-color == 0 ? #e8e8e8 : #333;
                    border-width: 1px; border-color: #555;
                    Text {
                        text: "Por gravedad"; font-size: 13px;
                        color: root.hl-color == 0 ? #111 : #e8e8e8;
                        width: parent.width; height: parent.height;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.hl-color = 0; } }
                }
                Rectangle {
                    height: 30px; horizontal-stretch: 1; border-radius: 4px;
                    background: root.hl-color == 1 ? #e8e8e8 : #333;
                    border-width: 1px; border-color: #555;
                    Text {
                        text: "Amarillo único"; font-size: 13px;
                        color: root.hl-color == 1 ? #111 : #e8e8e8;
                        width: parent.width; height: parent.height;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.hl-color = 1; } }
                }
            }
        }

        // --- resaltado libre: área o palabras
        VerticalLayout {
            spacing: 6px;
            Text { text: "Resaltar texto libre"; font-size: 14px; font-weight: 700; color: #e8e8e8; }
            Text {
                text: "• Por área: se resalta el rectángulo tal cual.";
                font-size: 12px; color: #aaa; wrap: word-wrap;
            }
            Text {
                text: "• Por texto: se resaltan las palabras que toque el rectángulo.";
                font-size: 12px; color: #aaa; wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    height: 30px; horizontal-stretch: 1; border-radius: 4px;
                    background: root.free-sel == 0 ? #e8e8e8 : #333;
                    border-width: 1px; border-color: #555;
                    Text {
                        text: "Por área"; font-size: 13px;
                        color: root.free-sel == 0 ? #111 : #e8e8e8;
                        width: parent.width; height: parent.height;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.free-sel = 0; } }
                }
                Rectangle {
                    height: 30px; horizontal-stretch: 1; border-radius: 4px;
                    background: root.free-sel == 1 ? #e8e8e8 : #333;
                    border-width: 1px; border-color: #555;
                    Text {
                        text: "Por texto"; font-size: 13px;
                        color: root.free-sel == 1 ? #111 : #e8e8e8;
                        width: parent.width; height: parent.height;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.free-sel = 1; } }
                }
            }
            // sub-opción: solo si se ha elegido "Por texto"
            if (root.free-sel == 1): VerticalLayout {
                spacing: 6px;
                Text {
                    text: "• Por recuadro: cada palabra va en su propia caja.";
                    font-size: 12px; color: #aaa; wrap: word-wrap;
                }
                Text {
                    text: "• Selección de texto: una banda continua por línea, como al seleccionar en un PDF.";
                    font-size: 12px; color: #aaa; wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 30px; horizontal-stretch: 1; border-radius: 4px;
                        background: root.free-text == 0 ? #e8e8e8 : #333;
                        border-width: 1px; border-color: #555;
                        Text {
                            text: "Por recuadro"; font-size: 13px;
                            color: root.free-text == 0 ? #111 : #e8e8e8;
                            width: parent.width; height: parent.height;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea { width: parent.width; height: parent.height; clicked => { root.free-text = 0; } }
                    }
                    Rectangle {
                        height: 30px; horizontal-stretch: 1; border-radius: 4px;
                        background: root.free-text == 1 ? #e8e8e8 : #333;
                        border-width: 1px; border-color: #555;
                        Text {
                            text: "Selección de texto"; font-size: 13px;
                            color: root.free-text == 1 ? #111 : #e8e8e8;
                            width: parent.width; height: parent.height;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea { width: parent.width; height: parent.height; clicked => { root.free-text = 1; } }
                    }
                }
            }
        }

        // --- copia de trabajo
        VerticalLayout {
            spacing: 6px;
            Text { text: "Copia de trabajo para las notas"; font-size: 14px; font-weight: 700; color: #e8e8e8; }
            Text {
                text: "• Preguntar: te aviso al abrir un documento.";
                font-size: 12px; color: #aaa; wrap: word-wrap;
            }
            Text {
                text: "• Crear siempre: la creo yo sin preguntar.";
                font-size: 12px; color: #aaa; wrap: word-wrap;
            }
            Text {
                text: "• Nunca: solo si la pides al guardar una nota.";
                font-size: 12px; color: #aaa; wrap: word-wrap;
            }
            Text {
                text: "Las notas van a {nombre}_anotado.pdf. El original nunca se toca.";
                font-size: 12px; color: #888; wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    height: 30px; horizontal-stretch: 1; border-radius: 4px;
                    background: root.copy-mode == 0 ? #e8e8e8 : #333;
                    border-width: 1px; border-color: #555;
                    Text {
                        text: "Preguntar"; font-size: 13px;
                        color: root.copy-mode == 0 ? #111 : #e8e8e8;
                        width: parent.width; height: parent.height;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.copy-mode = 0; } }
                }
                Rectangle {
                    height: 30px; horizontal-stretch: 1; border-radius: 4px;
                    background: root.copy-mode == 1 ? #e8e8e8 : #333;
                    border-width: 1px; border-color: #555;
                    Text {
                        text: "Crear siempre"; font-size: 13px;
                        color: root.copy-mode == 1 ? #111 : #e8e8e8;
                        width: parent.width; height: parent.height;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.copy-mode = 1; } }
                }
                Rectangle {
                    height: 30px; horizontal-stretch: 1; border-radius: 4px;
                    background: root.copy-mode == 2 ? #e8e8e8 : #333;
                    border-width: 1px; border-color: #555;
                    Text {
                        text: "Nunca"; font-size: 13px;
                        color: root.copy-mode == 2 ? #111 : #e8e8e8;
                        width: parent.width; height: parent.height;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.copy-mode = 2; } }
                }
            }
        }

        // --- motor
        VerticalLayout {
            spacing: 6px;
            Text { text: "Motor de revisión"; font-size: 14px; font-weight: 700; color: #e8e8e8; }
            Text {
                text: "• Activado: el texto se revisa con LanguageTool en este PC (nunca sale a Internet).";
                font-size: 12px; color: #aaa; wrap: word-wrap;
            }
            Text {
                text: "• Desactivado: no se envía ni una palabra a ningún proceso (no hay corrección).";
                font-size: 12px; color: #aaa; wrap: word-wrap;
            }
            Rectangle {
                height: 30px; border-radius: 4px;
                background: root.motor-on ? #e8e8e8 : #333;
                border-width: 1px; border-color: #555;
                Text {
                    text: root.motor-on ? "Motor activado (revisión local)" : "Motor desactivado (no se envía texto)";
                    font-size: 13px; color: root.motor-on ? #111 : #e8e8e8;
                    width: parent.width; height: parent.height;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea { width: parent.width; height: parent.height; clicked => { root.motor-on = !root.motor-on; } }
            }
        }

        // --- acerca de
        VerticalLayout {
            spacing: 6px;
            Text { text: "Acerca de"; font-size: 14px; font-weight: 700; color: #e8e8e8; }
            Rectangle {
                height: 32px; border-radius: 4px;
                background: #2d2d2d; border-width: 1px; border-color: #444;
                Text {
                    text: "Acerca de LexPDF"; font-size: 13px; color: #e8e8e8;
                    width: parent.width; height: parent.height;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { root.open-about(); }
                }
            }
            Text {
                text: "Todo el texto de la app y de las notas sale de tu equipo: no hay telemetría ni servidores.";
                font-size: 11px; color: #888; wrap: word-wrap;
            }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Rectangle {
                height: 30px; border-radius: 4px;
                background: #e8e8e8;
                Text {
                    text: "Guardar"; font-size: 13px; color: #111;
                    width: parent.width; height: parent.height;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { root.apply(root.hl-color, root.copy-mode, root.motor-on, root.free-sel, root.free-text); }
                }
            }
        }
    }
}

/// Una dependencia de la lista de licencias.
struct LicRow {
    name: string,
    lic: string,
}

// Ventana "Acerca de": logo, nombre de la app y botón de licencias.
// El logo se incrusta en la compilación (@image-url de assets/logo.png).
export component AboutWindow inherits Window {
    title: "Acerca de LexPDF";
    width: 460px;
    height: 460px;
    background: #1e1e1e;

    in-out property <string> version: "";
    in-out property <string> author: "";
    callback open-licenses();
    callback close-win();

    VerticalLayout {
        padding: 24px;
        spacing: 12px;

        // --- logo (assets/logo.png, incrustado en la compilacion)
        // ponytail: provisional; cambiar assets/logo.png y recompilar
        Rectangle {
            width: 104px; height: 104px;
            Image {
                source: @image-url("../assets/logo.png");
                width: parent.width; height: parent.height;
            }
        }

        Text { text: "LexPDF"; font-size: 26px; font-weight: 700; color: #e8e8e8; }
        Text { text: root.author; font-size: 14px; color: #bbb; }
        Text { text: root.version; font-size: 12px; color: #888; }
        Text {
            text: "Corrector ortográfico de escritorio. Todo el texto se revisa en tu equipo: no hay servidores ni telemetría.";
            font-size: 12px; color: #aaa; wrap: word-wrap;
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Rectangle {
                width: 104px; height: 30px; border-radius: 4px;
                background: #2d2d2d; border-width: 1px; border-color: #444;
                Text {
                    text: "Licencias"; font-size: 13px; color: #e8e8e8;
                    width: parent.width; height: parent.height;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { root.open-licenses(); }
                }
            }
            Rectangle {
                width: 78px; height: 30px; border-radius: 4px;
                background: #e8e8e8;
                Text {
                    text: "Cerrar"; font-size: 13px; color: #111;
                    width: parent.width; height: parent.height;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { root.close-win(); }
                }
            }
        }
    }
}

// Ventana de licencias: lista a la izquierda, texto completo + repo a la derecha.
export component LicensesWindow inherits Window {
    title: "Licencias · LexPDF";
    width: 820px;
    height: 620px;
    background: #1e1e1e;

    in-out property <[LicRow]> items;
    in-out property <int> sel: 0;
    in-out property <string> cur-name: "";
    in-out property <string> cur-lic: "";
    in-out property <string> cur-repo: "";
    in-out property <string> cur-text: "";
    in-out property <int> cur-h: 400;   // alto del texto (lo calcula Rust)
    callback select(int);
    callback open-link(string);

    HorizontalLayout {
        padding: 14px;
        spacing: 12px;

        VerticalLayout {
            width: 210px;
            spacing: 2px;
            for it[i] in root.items: Rectangle {
                height: 26px; border-radius: 4px;
                background: root.sel == i ? #3c3c3c : #262626;
                Text {
                    text: it.name; font-size: 12px; color: #ddd;
                    x: 8px; width: parent.width - 12px; height: parent.height;
                    vertical-alignment: center; overflow: elide;
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { root.select(i); }
                }
            }
        }

        Rectangle { width: 1px; background: #3d3d3d; }

        // panel derecho con posiciones absolutas: el Flickable del texto
        // necesita una altura propia (si no, toma el alto del texto y no
        // hay nada que deslizar)
        Rectangle {
            horizontal-stretch: 1;
            Text {
                x: 0; y: 0; width: parent.width; height: 24px;
                text: root.cur-name; font-size: 16px; font-weight: 700; color: #e8e8e8;
            }
            Text {
                x: 0; y: 26px; width: parent.width; height: 18px;
                text: root.cur-lic; font-size: 12px; color: #aaa;
            }
            Rectangle {
                x: 0; y: 48px; width: parent.width; height: 26px;
                background: #262626; border-radius: 4px; border-width: 1px; border-color: #444;
                Text {
                    x: 8px; width: parent.width - 16px; height: parent.height;
                    text: root.cur-repo; font-size: 12px; color: #7fb3ff;
                    vertical-alignment: center; overflow: elide;
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { root.open-link(root.cur-repo); }
                }
            }
            Flickable {
                x: 0; y: 84px;
                width: parent.width;
                height: parent.height - 84px;
                max-height: parent.height - 84px;
                content-width: 540px;
                content-height: root.cur-h * 1px;
                Text {
                    text: root.cur-text;
                    width: 520px;
                    height: root.cur-h * 1px;
                    wrap: word-wrap;
                    font-size: 11px; color: #bbb;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "LexPDF";
    min-width: 900px;
    min-height: 600px;
    init => { root.win-w = self.width; root.win-h = self.height; }
    changed width => { root.win-w = self.width; }
    changed height => { root.win-h = self.height; }

    in-out property <image> page-image;
    in-out property <string> page-label: "Sin documento";
    in-out property <string> status: "Sube un PDF para comenzar.";
    in-out property <int> lang-idx: 0;
    in-out property <bool> has-doc: false;
    in-out property <int> word-count: 0;
    in-out property <string> word-sample: "";
    in-out property <[ErrRow]> errors;
    in-out property <[NoteRow]> page-notes;
    in-out property <int> note-total: 0;
    in-out property <bool> has-working: true;
    // herramienta activa: 0 = normal · 1 = nota (sticky) · 2 = resaltar · 3 = borrar
    in-out property <int> tool-mode: 0;
    in-out property <string> tool-hint: "";
    // goma elástica del resaltado libre (px de la imagen de la página)
    in-out property <float> drag-x0: 0;
    in-out property <float> drag-y0: 0;
    in-out property <float> drag-x1: 0;
    in-out property <float> drag-y1: 0;
    in-out property <bool> drag-on: false;
    // tamaño real de la ventana (lo pone Rust): el velo del diálogo no puede
    // depender de parent.width o Slint ve un bucle de layout en el root
    in-out property <length> win-w: 0px;
    in-out property <length> win-h: 0px;
    // diálogo modal propio: 0 = confirmar (Sí/No) · 1 = contraseña
    in-out property <int> dlg-kind: 0;
    in-out property <string> dlg-title: "";
    in-out property <string> dlg-msg: "";
    in-out property <string> dlg-pass: "";
    in-out property <bool> dlg-open: false;
    in-out property <[HisRow]> history;
    in-out property <string> spell-status: "";
    in-out property <bool> is-dark: false;
    in-out property <bool> scanning: false;
    in-out property <int> scan-progress: 0;
    in-out property <string> scan-text: "";
    in-out property <string> lt-status: "Motor: iniciando…";
    in-out property <string> version: "?";
    in-out property <int> selected-note: -1;
    in-out property <string> note-text: "";
    in-out property <int> type-filter: 0;
    in-out property <int> sev-filter: 0;
    in-out property <string> popup-text: "";
    in-out property <int> img-w: 0;
    in-out property <int> img-h: 0;
    in-out property <string> zoom-label: "50%";
    in-out property <length> view-x: 0px;
    in-out property <length> view-y: 0px;
    in-out property <length> view-w: 0px;
    in-out property <length> view-h: 0px;
    in-out property <bool> free-note-on: false;
    in-out property <string> free-note-text: "";
    // texto realmente seleccionado en el resaltado libre (vacío si no hay)
    in-out property <string> free-sel-text: "";

    callback open-pdf();
    callback prev-page();
    callback next-page();
    callback error-clicked(int);
    callback omit-clicked(int);
    callback note-clicked(int);
    callback save-note(int);
    callback grammar-clicked(int);
    callback group-toggle(int);
    callback type-set(int);
    callback sev-set(int);
    callback popup-dismiss();
    callback history-open(int);
    callback zoom-in();
    callback zoom-out();
    callback zoom-text(string);
    callback page-clicked(float, float);
    callback free-note-new();
    callback free-note-save();
    callback free-note-cancel();
    callback lang-set(int);
    callback theme-toggle();
    callback dlg-answer(bool);
    callback make-working();
    callback page-rect(float, float, float, float);
    callback delete-anno(int);
    callback open-settings();
    callback highlight-new();
    callback delete-mode();
    callback delete-note(int);
    callback note-cancel(int);
    // valores guardados (el panel de ajustes los carga al abrirse)
    in-out property <int> set-hl-color: 0;
    in-out property <int> set-copy-mode: 0;
    in-out property <bool> set-motor: true;

    // paleta según tema (fija, no depende del tema del SO)
    property <color> c-bg: root.is-dark ? #1e1e1e : white;
    property <color> c-fg: root.is-dark ? #e8e8e8 : #222;
    property <color> c-dim: root.is-dark ? #aaa : #666;
    property <color> c-line: root.is-dark ? #444 : #ddd;
    property <color> c-card: root.is-dark ? #2d2d2d : white;
    property <color> c-view: root.is-dark ? #141414 : #e9e9e9;
    property <color> c-pill: root.is-dark ? #333 : #eee;
    property <color> c-input: root.is-dark ? #1a1a1a : white;
    property <color> c-input-line: root.is-dark ? #6a6a6a : #ddd;
    property <color> c-accent: root.is-dark ? #e8e8e8 : #222;
    property <color> c-accent-fg: root.is-dark ? #111 : white;

    // wrapper: único hijo del root. Así el velo del diálogo es un hijo más
    // del contenedor (posición absoluta) y no reparte el espacio con el layout.
    Rectangle {
    width: 100%; height: 100%;
    HorizontalLayout {
        // Sidebar (400px como index.html)
        Rectangle {
            width: 400px;
            background: root.c-bg;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                alignment: start;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "LexPDF";
                        font-size: 18px; font-weight: 700; color: root.c-fg;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 64px; height: 28px;
                        background: root.c-pill; border-radius: 4px;
                        Text {
                            text: root.is-dark ? "Claro" : "Oscuro";
                            color: root.c-fg; font-size: 12px;
                            width: parent.width; height: parent.height;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea { width: parent.width; height: parent.height; clicked => { root.theme-toggle(); } }
                    }
                }

                // sin copia de trabajo: se puede crear en cualquier momento
                if (root.has-doc && !root.has-working): Rectangle {
                    height: 28px;
                    background: root.c-pill; border-radius: 4px;
                    border-width: 1px; border-color: root.c-line;
                    Text {
                        text: "Crear copia de trabajo para guardar notas";
                        color: root.c-fg; font-size: 11px;
                        width: parent.width; height: parent.height;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.make-working(); } }
                }

                // upload-section
                Rectangle {
                    height: 34px;
                    background: root.c-accent;
                    border-radius: 4px;
                    Text {
                        text: "Subir y Analizar Documento";
                        color: root.c-accent-fg; font-size: 14px;
                        width: parent.width; height: parent.height;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { width: parent.width; height: parent.height; clicked => { open-pdf(); } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    for m[i] in ["ES", "EN"]: Rectangle {
                        height: 26px;
                        horizontal-stretch: 1;
                        background: root.lang-idx == i ? root.c-accent : root.c-pill;
                        border-radius: 4px;
                        Text {
                            text: m;
                            color: root.lang-idx == i ? root.c-accent-fg : root.c-fg;
                            font-size: 12px;
                            width: parent.width; height: parent.height;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea { width: parent.width; height: parent.height; clicked => { root.lang-set(i); } }
                    }
                }
                Text { text <=> root.status; font-size: 13px; color: root.c-dim; wrap: word-wrap; }

                if (root.history.length > 0): VerticalLayout {
                    spacing: 4px;
                    Text { text: "Recientes"; font-size: 14px; font-weight: 700; color: root.c-fg; }
                    VerticalLayout {
                        spacing: 2px;
                        for h[i] in root.history: Rectangle {
                            height: 30px;
                            background: root.c-pill; border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 6px;
                                Text {
                                    text: h.name; color: root.c-fg; font-size: 12px; font-weight: 700;
                                    horizontal-stretch: 1; vertical-alignment: center; overflow: elide;
                                }
                                Text { text: h.info; color: root.c-dim; font-size: 11px; vertical-alignment: center; }
                            }
                            TouchArea { width: parent.width; height: parent.height; clicked => { root.history-open(i); } }
                        }
                    }
                }

                Rectangle { height: 1px; background: root.c-line; }

                // barra de escaneo: izquierda a derecha, verde
                Rectangle {
                    height: 10px;
                    background: root.c-pill; border-radius: 5px;
                    visible: root.scanning;
                    Rectangle {
                        x: 0;
                        width: parent.width * root.scan-progress / 100;
                        background: #43a047; border-radius: 5px;
                    }
                }
                Text {
                    text <=> root.scan-text; font-size: 12px; color: root.c-dim;
                    visible: root.scanning;
                }
                Text {
                    text <=> root.lt-status; font-size: 12px; color: root.c-dim;
                }
                Text {
                    text: "LexPDF v" + root.version + " · 100% local";
                    font-size: 11px; color: root.c-dim;
                }

                // resultados
                Text { text: "Resultados"; font-size: 14px; font-weight: 700; color: root.c-fg; }
                Text {
                    text: root.word-count + " palabras · " + root.spell-status;
                    font-size: 13px; font-weight: 700; color: root.c-fg;
                    visible: root.has-doc;
                }
                HorizontalLayout {
                    spacing: 6px;
                    visible: root.has-doc;
                    DropSel {
                        label: "Tipo";
                        opts: ["Todas", "Ortografía", "Sintaxis"];
                        current <=> root.type-filter;
                        bg: root.c-pill; fg: root.c-fg; bd: root.is-dark ? root.c-line : transparent;
                        hl: root.c-accent; hl-fg: root.c-accent-fg;
                        horizontal-stretch: 1;
                        picked(i) => { root.type-set(i); }
                    }
                    DropSel {
                        label: "Gravedad";
                        opts: ["Todas", "Grave", "Intermedia", "Mínima"];
                        current <=> root.sev-filter;
                        bg: root.c-pill; fg: root.c-fg; bd: root.is-dark ? root.c-line : transparent;
                        hl: root.c-accent; hl-fg: root.c-accent-fg;
                        horizontal-stretch: 1;
                        picked(i) => { root.sev-set(i); }
                    }
                }
                Flickable {
                    height: 420px;
                    visible: root.has-doc;
                    VerticalLayout {
                        spacing: 6px;
                        for e[i] in root.errors: Rectangle {
                            border-color: root.c-line;
                            border-width: 1px;
                            border-radius: 6px;
                            background: root.c-card;
                            opacity: e.dimmed ? 0.45 : 1;
                            HorizontalLayout {
                                spacing: 0;
                                // franja de color por tipo, como index.html
                                Rectangle { width: 5px; background: e.bar; }
                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 3px;
                                    horizontal-stretch: 1;
                                    Rectangle {
                                        height: 20px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text { text: e.word; font-size: 14px; font-weight: 700; color: root.c-fg; vertical-alignment: center; }
                                            Text { text: e.kind + " · " + e.sev + " · pág " + (e.page + 1); font-size: 12px; color: root.c-dim; vertical-alignment: center; }
                                        }
                                        TouchArea { width: parent.width; height: parent.height; clicked => { root.error-clicked(i); } }
                                    }
                                    Text { text: e.desc; font-size: 13px; font-italic: true; color: root.c-dim; wrap: word-wrap; }
                                    Text { text: e.sug; font-size: 12px; color: root.c-fg; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        MiniBtn {
                                            label: e.dimmed ? "Restaurar" : "Omitir";
                                            bg: root.c-pill; fg: root.c-fg; bd: root.is-dark ? root.c-line : transparent;
                                            clicked => { root.omit-clicked(i); }
                                        }
                                        MiniBtn {
                                            label: "Comentar";
                                            bg: root.c-pill; fg: root.c-fg; bd: root.is-dark ? root.c-line : transparent;
                                            clicked => { root.note-clicked(i); }
                                        }
                                        MiniBtn {
                                            label: "Obs. gramatical";
                                            bg: root.c-pill; fg: root.c-fg; bd: root.is-dark ? root.c-line : transparent;
                                            clicked => { root.grammar-clicked(i); }
                                        }
                                        MiniBtn {
                                            label: "Borrar";
                                            bg: root.c-pill; fg: root.c-fg; bd: root.is-dark ? root.c-line : transparent;
                                            visible: e.has_anno;
                                            clicked => { root.delete-anno(i); }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        visible: e.count >= 5;
                                        MiniBtn {
                                            label: e.is-group ? "Desagrupar (×" + e.count + ")" : "Agrupar (×" + e.count + ")";
                                            bg: root.c-pill; fg: root.c-fg; bd: root.is-dark ? root.c-line : transparent;
                                            clicked => { root.group-toggle(i); }
                                        }
                                    }
                                    // Editor del comentario. Es un bloque `if` (no
                                    // `visible`): así los elementos se crean al
                                    // abrirlo y el campo coge el foco (se puede
                                    // escribir sin tener que tocarlo).
                                    if (root.selected-note == i): VerticalLayout {
                                        spacing: 3px;
                                        Rectangle {
                                            height: 30px;
                                            background: root.c-input; border-radius: 4px;
                                            border-width: 1px; border-color: root.c-input-line;
                                            // placeholder (Slint 1.18 no lo tiene)
                                            Text {
                                                x: 8px; width: parent.width - 16px; height: parent.height;
                                                text: "Escriba aquí el comentario...";
                                                font-size: 13px; color: root.c-dim;
                                                vertical-alignment: center;
                                                visible: root.note-text == "";
                                            }
                                            TextInput {
                                                x: 8px; width: parent.width - 16px; height: parent.height;
                                                text <=> root.note-text;
                                                font-size: 13px; color: root.c-fg;
                                                vertical-alignment: center;
                                                init => { self.focus(); }
                                                accepted => {
                                                    if (root.note-text != "") { root.save-note(root.selected-note); }
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            MiniBtn {
                                                label: "Guardar";
                                                bg: root.c-accent; fg: root.c-accent-fg; bd: root.is-dark ? root.c-line : transparent;
                                                clicked => { root.save-note(i); }
                                            }
                                            MiniBtn {
                                                label: "Cancelar";
                                                bg: root.c-pill; fg: root.c-fg; bd: root.is-dark ? root.c-line : transparent;
                                                clicked => { root.note-cancel(i); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                Text {
                    text: "El visor PDF aparecerá a la derecha cuando abras un documento.";
                    font-size: 13px; color: root.c-dim; wrap: word-wrap;
                    horizontal-alignment: center;
                    visible: !root.has-doc;
                }
                // pista: las notas ya no se listan, se ven al pasar el ratón por el marcador
                if (root.page-notes.length > 0): Text {
                    text: "Notas: " + root.page-notes.length + " en esta página · "
                        + root.note-total + " en el documento · pásale el ratón por los marcadores ámbar";
                    font-size: 11px; color: root.c-dim; wrap: word-wrap;
                }
            }
        }

        // visor
        Rectangle {
            background: root.c-view;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                if (root.has-doc): HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Rectangle {
                        width: 34px; height: 28px;
                        background: root.c-pill; border-radius: 4px;
                        IconArrowBack {
                            width: 18px; height: 18px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            fill: root.c-fg;
                        }
                        TouchArea { width: parent.width; height: parent.height; clicked => { prev-page(); } }
                    }
                    Text { text <=> root.page-label; font-size: 13px; color: root.c-dim; vertical-alignment: center; }
                    Rectangle {
                        width: 34px; height: 28px;
                        background: root.c-pill; border-radius: 4px;
                        IconArrowFwd {
                            width: 18px; height: 18px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            fill: root.c-fg;
                        }
                        TouchArea { width: parent.width; height: parent.height; clicked => { next-page(); } }
                    }
                    Rectangle {
                        width: 66px; height: 28px;
                        background: root.c-pill; border-radius: 4px;
                        IconNoteAdd {
                            width: 16px; height: 16px;
                            x: 8px; y: (parent.height - self.height) / 2;
                            fill: root.c-fg;
                        }
                        Text {
                            text: "Nota"; color: root.c-fg; font-size: 12px;
                            x: 28px; y: (parent.height - self.height) / 2;
                            vertical-alignment: center;
                        }
                        TouchArea { width: parent.width; height: parent.height; clicked => { free-note-new(); } }
                    }
                    // resaltar texto libre (arrastrando un rectángulo)
                    Rectangle {
                        width: 30px; height: 28px;
                        background: root.tool-mode == 2 ? root.c-accent : root.c-pill;
                        border-radius: 4px;
                        IconMarker {
                            width: 18px; height: 18px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            fill: root.tool-mode == 2 ? root.c-accent-fg : root.c-fg;
                        }
                        TouchArea { width: parent.width; height: parent.height; clicked => { highlight-new(); } }
                    }
                    // borrar anotaciones (pinchar en el marcador)
                    Rectangle {
                        width: 30px; height: 28px;
                        background: root.tool-mode == 3 ? root.c-accent : root.c-pill;
                        border-radius: 4px;
                        IconDelete {
                            width: 18px; height: 18px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            fill: root.tool-mode == 3 ? root.c-accent-fg : root.c-fg;
                        }
                        TouchArea { width: parent.width; height: parent.height; clicked => { delete-mode(); } }
                    }
                    // ajustes
                    Rectangle {
                        width: 30px; height: 28px;
                        background: root.c-pill; border-radius: 4px;
                        IconSettings {
                            width: 18px; height: 18px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            fill: root.c-fg;
                        }
                        TouchArea { width: parent.width; height: parent.height; clicked => { root.open-settings(); } }
                    }
                    TouchArea {
                        width: 122px; height: 28px;
                        scroll-event(e) => {
                            if (e.delta-y > 0px) { zoom-in(); } else if (e.delta-y < 0px) { zoom-out(); }
                            accept
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                width: 28px; height: 28px;
                                background: root.c-pill; border-radius: 4px;
                                IconZoomOut {
                                    width: 18px; height: 18px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    fill: root.c-fg;
                                }
                                TouchArea { width: parent.width; height: parent.height; clicked => { zoom-out(); } }
                            }
                            Rectangle {
                                width: 58px; height: 28px;
                                background: root.c-pill; border-radius: 4px;
                                TextInput {
                                    text: root.zoom-label;
                                    color: root.c-fg; font-size: 12px;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    accepted => { root.zoom-text(self.text); }
                                }
                            }
                            Rectangle {
                                width: 28px; height: 28px;
                                background: root.c-pill; border-radius: 4px;
                                IconZoomIn {
                                    width: 18px; height: 18px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    fill: root.c-fg;
                                }
                                TouchArea { width: parent.width; height: parent.height; clicked => { zoom-in(); } }
                            }
                        }
                    }
                }

                if (root.has-doc): Flickable {
                    min-height: 200px;
                    vertical-stretch: 1;
                    // en modo resaltar (2) el scroll se apaga: si no, el
                    // Flickable se come el arrastre del rectángulo
                    interactive: root.tool-mode != 2;
                    content-width: root.img-w * 1px;
                    content-height: root.img-h * 1px;
                    content-x <=> root.view-x;
                    content-y <=> root.view-y;
                    // changed no dispara al inicio: sin init el centrado divide con 0
                    init => { root.view-w = self.width; root.view-h = self.height; }
                    changed width => { root.view-w = self.width; }
                    changed height => { root.view-h = self.height; }
                    Rectangle {
                        width: root.img-w * 1px;
                        height: root.img-h * 1px;
                        Image {
                            source <=> root.page-image;
                            width: 100%; height: 100%;
                        }
                        // notas nativas: zona sensible sobre el marcador -> tooltip al pasar el ratón.
                        // va ANTES del pg-touch: en modo nota el TouchArea de arriba se come el hover.
                        // GOTCHA: el Tooltip va DENTRO del TouchArea: si cuelga del
                        // Rectangle, el hover lo tiene el TouchArea (el hijo) y el
                        // tooltip no sale nunca.
                        // Zona sensible de cada nota: el resaltado usa su
                        // rectángulo entero (el tooltip sale al pasar por
                        // encima del texto), la nota pegajosa una cajita.
                        // Solo activa en modo normal y borrar: si no, el
                        // TouchArea se come el arrastre del resaltado libre
                        // y el clic de la nota.
                        for n in root.page-notes: nota := Rectangle {
                            x: n.x * 1px; y: n.y * 1px;
                            width: n.w * 1px; height: n.h * 1px;
                            ta := TouchArea {
                                enabled: root.tool-mode == 0 || root.tool-mode == 3;
                                width: parent.width; height: parent.height;
                                clicked => { if (root.tool-mode == 3) { root.delete-note(n.idx); } }
                            }
                            // El comentario sale ENCIMA del resaltado. El
                            // Tooltip nativo siempre sale abajo del puntero y
                            // no se puede colocar: esto es un chip propio que
                            // se mueve con la pagina.
                            if (ta.has-hover): chip := Rectangle {
                                x: 0px; y: -30px;
                                width: min(300px, chip-txt.width + 12px);
                                height: 26px;
                                background: #1b1b1be8; border-radius: 4px;
                                border-width: 1px; border-color: #ffffff40;
                                chip-txt := Text {
                                    x: 6px; y: (parent.height - self.height) / 2;
                                    text: n.text; color: #ffffff; font-size: 12px;
                                }
                            }
                        }
                        // goma elástica del resaltado libre (modo 2)
                        Rectangle {
                            x: min(root.drag-x0, root.drag-x1) * 1px;
                            y: min(root.drag-y0, root.drag-y1) * 1px;
                            width: abs(root.drag-x1 - root.drag-x0) * 1px;
                            height: abs(root.drag-y1 - root.drag-y0) * 1px;
                            visible: root.drag-on;
                            background: #ffd54f88;
                            border-width: 1px; border-color: #ffb300;
                        }
                        // puntero/arrastre sobre la página (modos nota y resaltar)
                        if (root.tool-mode == 1 || root.tool-mode == 2): pg-touch := TouchArea {
                            width: 100%; height: 100%;
                            changed pressed => {
                                if (self.pressed) {
                                    root.drag-x0 = self.pressed-x / 1px;
                                    root.drag-y0 = self.pressed-y / 1px;
                                    root.drag-x1 = root.drag-x0;
                                    root.drag-y1 = root.drag-y0;
                                    root.drag-on = true;
                                }
                            }
                            moved => {
                                root.drag-x1 = self.mouse-x / 1px;
                                root.drag-y1 = self.mouse-y / 1px;
                            }
                            clicked => {
                                root.drag-on = false;
                                if (root.tool-mode == 2) {
                                    root.page-rect(root.drag-x0, root.drag-y0, self.mouse-x / 1px, self.mouse-y / 1px);
                                } else {
                                    root.page-clicked(self.mouse-x / 1px, self.mouse-y / 1px);
                                }
                            }
                        }
                    }
                }

                if (root.free-note-on): VerticalLayout {
                    spacing: 3px;
                    visible: root.has-doc;
                    // Text con alto FIJO: con wrap y alto implícito el layout
                    // reparte el espacio y el panel se descuadra
                    Text {
                        text: root.tool-mode == 2 ? "Escribe el comentario del resaltado y guarda." : "Toca el punto del documento, escribe y guarda.";
                        font-size: 12px; color: root.c-dim; wrap: word-wrap;
                        height: 16px;
                    }
                    // el texto seleccionado, en negrita para que se vea claro
                    if (root.free-sel-text != ""): Text {
                        text: "Seleccionado: «" + root.free-sel-text + "»";
                        font-size: 12px; font-weight: 700; color: root.c-fg; wrap: word-wrap;
                        height: 16px;
                    }
                    Rectangle {
                        height: 30px;
                        background: root.c-input; border-radius: 4px;
                        border-width: 1px; border-color: root.c-input-line;
                        // placeholder (Slint 1.18 no lo tiene)
                        Text {
                            x: 8px; width: parent.width - 16px; height: parent.height;
                            text: root.tool-mode == 2 ? "Escriba aquí el comentario..." : "Escriba aquí la nota...";
                            font-size: 13px; color: root.c-fg;
                            vertical-alignment: center;
                            visible: root.free-note-text == "";
                        }
                        TextInput {
                            x: 8px; width: parent.width - 16px; height: parent.height;
                            text <=> root.free-note-text;
                            font-size: 13px; color: root.c-fg;
                            vertical-alignment: center;
                            init => { self.focus(); }
                            accepted => { if (root.free-note-text != "") { root.free-note-save(); } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        MiniBtn {
                            label: root.tool-mode == 2 ? "Guardar resaltado" : "Guardar nota";
                            bg: root.c-accent; fg: root.c-accent-fg; bd: root.is-dark ? root.c-line : transparent;
                            clicked => { root.free-note-save(); }
                        }
                        MiniBtn {
                            label: "Cancelar";
                            bg: root.c-pill; fg: root.c-fg; bd: root.is-dark ? root.c-line : transparent;
                            clicked => { root.free-note-cancel(); }
                        }
                    }
                }

                if (!root.has-doc): Text {
                    text: "Sin documento";
                    font-size: 14px; color: root.c-dim;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    vertical-stretch: 1;
                }
            }
            // toast minimalista: pastilla centrada abajo, clic para cerrar
            if (root.popup-text != ""): Rectangle {
                width: min(520px, parent.width - 32px);
                height: 52px;
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 16px;
                background: root.c-accent; border-radius: 8px;
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px; spacing: 10px;
                    Text {
                        text: root.popup-text;
                        color: root.c-accent-fg; font-size: 13px;
                        horizontal-stretch: 1; vertical-alignment: center;
                        wrap: word-wrap; overflow: elide;
                    }
                    Text { text: "✕"; color: root.c-accent-fg; font-size: 12px; vertical-alignment: center; }
                }
                TouchArea { width: parent.width; height: parent.height; clicked => { root.popup-dismiss(); } }
            }
        }
    }

        // diálogo modal centrado, con degradado sobre el resto de la app.
        // el velo es un Rectangle (no TouchArea): los botones de abajo siguen siendo clicables.
        Rectangle {
            x: 0; y: 0;
            width: root.win-w; height: root.win-h;
            visible: root.dlg-open;
            background: @radial-gradient(circle, #000000b0, #00000040);
            Rectangle {
                width: 440px;
                height: root.dlg-kind == 1 ? 210px : 165px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: root.c-card;
                border-color: root.c-line; border-width: 1px; border-radius: 10px;
                VerticalLayout {
                    padding: 16px; spacing: 10px;
                    Text {
                        text: root.dlg-title; font-size: 15px; font-weight: 700;
                        color: root.c-fg; wrap: word-wrap;
                    }
                    Text { text: root.dlg-msg; font-size: 13px; color: root.c-dim; wrap: word-wrap; }
                    if (root.dlg-kind == 1): Rectangle {
                        height: 30px;
                        background: root.c-pill; border-radius: 4px;
                        TextInput {
                            x: 8px; width: parent.width - 16px; height: parent.height;
                            text <=> root.dlg-pass;
                            font-size: 13px; color: root.c-fg;
                            input-type: password;
                            vertical-alignment: center;
                            accepted => { root.dlg-answer(true); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        MiniBtn {
                            label: root.dlg-kind == 1 ? "Cancelar" : "Ahora no";
                            bg: root.c-pill; fg: root.c-fg; bd: root.is-dark ? root.c-line : transparent;
                            clicked => { root.dlg-answer(false); }
                        }
                        MiniBtn {
                            label: root.dlg-kind == 1 ? "Abrir" : "Sí, crear";
                            bg: root.c-accent; fg: root.c-accent-fg; bd: root.is-dark ? root.c-line : transparent;
                            clicked => { root.dlg-answer(true); }
                        }
                    }
                }
            }
        }
    }
}
